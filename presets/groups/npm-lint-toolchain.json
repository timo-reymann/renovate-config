{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "typescript-eslint",
        "prettier"
      ],
      "groupName": "npm lint/format toolchain"
    }
  ]
}
