{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "poetry",
        "pep621",
        "pip_requirements"
      ],
      "matchPackageNames": [
        "setuptools",
        "setuptools-scm",
        "wheel",
        "build",
        "twine"
      ],
      "groupName": "python packaging/release toolchain"
    }
  ]
}
