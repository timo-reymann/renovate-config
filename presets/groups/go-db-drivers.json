{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchPackagePatterns": [
        "^github.com/golang-migrate/migrate",
        "^github.com/lib/pq",
        "^github.com/mattn/go-sqlite3"
      ],
      "groupName": "DB drivers & migrations"
    }
  ]
}
