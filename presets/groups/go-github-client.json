{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchPackagePatterns": [
        "^github.com/google/go-github",
        "^github.com/google/go-querystring"
      ],
      "groupName": "GitHub API client"
    }
  ]
}
