{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "semantic-release"
      ],
      "matchPackagePatterns": [
        "^@semantic-release/"
      ],
      "groupName": "semantic-release toolchain"
    }
  ]
}
