{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "fastify"
      ],
      "matchPackagePatterns": [
        "^@fastify/"
      ],
      "groupName": "Fastify ecosystem"
    }
  ]
}
