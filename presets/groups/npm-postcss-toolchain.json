{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "postcss",
        "cssnano",
        "autoprefixer"
      ],
      "matchPackagePatterns": [
        "^postcss-"
      ],
      "groupName": "PostCSS toolchain"
    }
  ]
}
