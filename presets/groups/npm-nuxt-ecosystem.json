{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "nuxt",
        "pinia"
      ],
      "matchPackagePatterns": [
        "^@nuxt/",
        "^@nuxtjs/",
        "^@pinia/",
        "^@unocss/",
        "^@vite-pwa/",
        "^@vueuse/"
      ],
      "groupName": "Nuxt ecosystem"
    }
  ]
}
