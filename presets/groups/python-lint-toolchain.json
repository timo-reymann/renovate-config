{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "poetry",
        "pep621",
        "pip_requirements"
      ],
      "matchPackageNames": [
        "ruff",
        "mypy"
      ],
      "matchPackagePatterns": [
        "^types-"
      ],
      "groupName": "python lint/type-check toolchain"
    }
  ]
}
